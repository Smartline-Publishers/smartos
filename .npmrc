# npm 10.9.2 (Cloudflare's build image) resolves the optional vitest peer
# declared by @cloudflare/workers-utils (a dependency of wrangler) and then
# reports the lockfile as out of sync. npm 12 skips it. Ignoring peer deps
# keeps `npm ci` reproducible across npm versions; all required peers
# (@opennextjs/cloudflare -> next, wrangler) are declared explicitly.
legacy-peer-deps=true
