{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "smartos",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "images": {
    "binding": "IMAGES"
  },
  // Runtime secret required by clerkMiddleware(). Wrangler refuses to deploy
  // without it, instead of deploying a Worker that 500s on every request.
  "secrets": {
    "required": ["CLERK_SECRET_KEY"]
  }
}